{
  "multipart": [
    {
      "apply": {
        "model": "runecraft:block/herb_patch"
      }
    },
    {
      "when": {
        "stage": "1|2|3"
      },
      "apply": {
        "model": "runecraft:block/herb_patch_growing"
      }
    },
    {
      "when": {
        "stage": "4"
      },
      "apply": {
        "model": "runecraft:block/herb_patch_grown"
      }
    }
  ]
}
